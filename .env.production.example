# Production environment for the Hetzner deploy.
# Copy to `.env` on the server (chmod 600) and fill in real values. NEVER commit the real .env.
#
#   cp .env.production.example .env && chmod 600 .env

# --- Admin back-office credentials (required in production) ---
ADMIN_USER=admin
ADMIN_PASSWORD=            # set a strong password — do NOT ship the default "changeme"

# --- Session signing secret (required) ---
# Generate once with:  openssl rand -hex 32
SESSION_SECRET=

# --- Public URL (used for OG/meta tags) ---
# Must match the hostname served by Caddy.
PUBLIC_BASE_URL=https://opportunities.wiemibncheikh.com

# PORT and DATA_DIR are set by docker-compose.prod.yml (3000 / /data) — no need to set them here.
