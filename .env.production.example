# Production environment for the Hetzner deploy.
# Copy to `.env` on the server (chmod 600) and fill in real values. NEVER commit the real .env.
#
#   cp .env.production.example .env && chmod 600 .env

# --- Admin back-office credentials (required in production) ---
ADMIN_USER=admin
ADMIN_PASSWORD=            # set a strong password — do NOT ship the default "changeme"

# --- Session signing secret (required) ---
# Generate once with:  openssl rand -hex 32
SESSION_SECRET=

# --- Public URL (used for OG/meta tags + email links) ---
# Must match the hostname served by Caddy.
PUBLIC_BASE_URL=https://opportunities.wiemibncheikh.com

# --- Email: Brevo SMTP relay (same mechanism & account as ChatFlow) ---
# Reuse ChatFlow's Brevo SMTP credentials. The sender domain (wiemibncheikh.com) is already
# SPF/DKIM-verified in that Brevo account, so contact@wiemibncheikh.com sends cleanly.
# If SMTP_HOST is left empty, newsletter confirmation emails are simply skipped (no crash).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false                                  # 587 => STARTTLS
SMTP_USER=                                          # Brevo SMTP login (reuse ChatFlow's)
SMTP_PASSWORD=                                      # Brevo SMTP key   (reuse ChatFlow's)
MAIL_FROM=WiwiOpportunity <contact@wiemibncheikh.com>

# PORT and DATA_DIR are set by docker-compose.prod.yml (3000 / /data) — no need to set them here.
