{
  "name": "wiwiopportunity",
  "version": "1.1.0",
  "description": "Plateforme d'opportunités à l'international (stages, études, volontariat, bourses...).",
  "main": "server/app.js",
  "scripts": {
    "start": "node --experimental-sqlite server/app.js",
    "dev": "nodemon --exec \"node --experimental-sqlite\" server/app.js",
