<%- include('partials/header', { title: t('meta.adminEditTitle'), page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <h1><%= t('admin.editTitle') %></h1>

      <form action="/admin/edit/<%= opp.id %>" method="post" class="admin-form">
        <div class="admin-grid">
          <input type="checkbox" name="featured" value="1" <%= opp.featured ? 'checked' : '' %> />

          <div class="form-group">
            <label for="title"><%= t('admin.fields.title') %> <span class="required">*</span></label>
            <input type="text" id="title" name="title" value="<%= opp.title %>" required />
          </div>

          <div class="form-group">
            <label for="organization"><%= t('admin.fields.organization') %></label>
            <input type="text" id="organization" name="organization" value="<%= opp.organization || '' %>" />
          </div>

          <div class="form-group">
            <label for="country"><%= t('admin.fields.country') %> <span class="required">*</span></label>
            <input type="text" id="country" name="country" value="<%= opp.country || '' %>" required />
          </div>

          <div class="form-group">
            <label for="city"><%= t('admin.fields.city') %></label>
            <input type="text" id="city" name="city" value="<%= opp.city || '' %>" />
          </div>

          <div class="form-group">
            <label for="type"><%= t('admin.fields.type') %> <span class="required">*</span></label>
            <select id="type" name="type" required>
              <option value=""><%= t('common.select') %>...</option>
              <option value="Stage" <%= opp.type === 'Stage' ? 'selected' : '' %>><%= t('options.types.stage') %></option>
              <option value="Bourse" <%= opp.type === 'Bourse' ? 'selected' : '' %>><%= t('options.types.scholarship') %></option>
              <option value="Volontariat" <%= opp.type === 'Volontariat' ? 'selected' : '' %>><%= t('options.types.volunteering') %></option>
              <option value="Job" <%= opp.type === 'Job' ? 'selected' : '' %>><%= t('options.types.job') %></option>
            </select>
          </div>

          <div class="form-group">
            <label for="funding"><%= t('admin.fields.funding') %></label>
            <select id="funding" name="funding">
              <option value="" <%= !opp.funding ? 'selected' : '' %>><%= t('options.funding.unspecified') %></option>
              <option value="Fully funded" <%= opp.funding === 'Fully funded' ? 'selected' : '' %>><%= t('options.funding.fully') %></option>
              <option value="Partially funded" <%= opp.funding === 'Partially funded' ? 'selected' : '' %>><%= t('options.funding.partial') %></option>
              <option value="Non finance" <%= opp.funding === 'Non finance' ? 'selected' : '' %>><%= t('options.funding.none') %></option>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline"><%= t('admin.fields.deadline') %></label>
            <input type="date" id="deadline" name="deadline" value="<%= opp.deadline || '' %>" />
          </div>

          <div class="form-group">
            <label for="duration"><%= t('admin.fields.duration') %></label>
            <input type="text" id="duration" name="duration" value="<%= opp.duration || '' %>" />
          </div>

          <div class="form-group">
            <label for="link"><%= t('admin.fields.link') %></label>
            <input type="url" id="link" name="link" value="<%= opp.link || '' %>" />
          </div>

          <div class="form-group">
            <label for="tags"><%= t('admin.fields.tags') %></label>
            <input type="text" id="tags" name="tags" value="<%= Array.isArray(opp.tags) ? opp.tags.join(', ') : '' %>" />
          </div>
        </div>

        <div class="form-group">
          <label for="description"><%= t('admin.fields.description') %></label>
          <textarea id="description" name="description" rows="4"><%= opp.description || '' %></textarea>
        </div>

        <div class="form-group">
          <label for="extra"><%= t('admin.fields.extra') %></label>
          <textarea id="extra" name="extra" rows="4"><%= opp.extra || '' %></textarea>
        </div>

        <div class="admin-actions">
          <a href="/admin" class="btn-secondary"><%= t('common.cancel') %></a>
          <button type="submit" class="btn-primary"><%= t('admin.saveEdit') %></button>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
