<%- include('partials/header', { title: t('meta.detailTitle'), page: 'detail', baseUrl }) %>

<main class="main-layout">
  <article class="detail-layout">
    <section class="detail-main" id="detail-main">
      <p><%= t('detail.loading') %></p>
    </section>

    <aside class="detail-sidebar" id="detail-sidebar">
      <!-- rempli par detail.js -->
    </aside>
  </article>

  <section class="detail-social-promo">
    <div class="detail-social-card">
      <h3><%= t('detail.socialTitle') %></h3>
      <p><%= t('detail.socialText') %></p>
      <div class="social-cta-links">
        <%- include('partials/social-links') %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'detail' }) %>
