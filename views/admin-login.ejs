<%- include('partials/header', { title: t('meta.adminLoginTitle'), page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <h1><%= t('admin.loginTitle') %></h1>
      <p class="admin-intro">
        <%= t('admin.loginIntro') %>
      </p>

      <% if (error) { %>
        <p style="color:#dc2626;font-size:0.9rem;margin-bottom:10px;"><%= error %></p>
      <% } %>

      <form action="/admin/login" method="post" class="admin-form">
        <div class="admin-grid">
          <div class="form-group">
            <label for="username"><%= t('admin.username') %></label>
            <input id="username" name="username" required />
          </div>
          <div class="form-group">
            <label for="password"><%= t('admin.password') %></label>
            <input id="password" type="password" name="password" required />
          </div>
        </div>

        <div class="admin-actions">
          <button type="submit" class="btn-primary"><%= t('admin.loginButton') %></button>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
