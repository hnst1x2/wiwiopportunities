<%- include('partials/header', { title: t('meta.adminLoginTitle'), page: 'admin', baseUrl }) %>

<main id="main" class="container admin-login-page">
  <div class="login-card">
    <img src="/img/opportunities-by-wiem-avatar.svg" alt="" width="44" height="44" class="login-mark" />
    <h1 class="login-title"><%= t('admin.loginTitle') %></h1>
    <p class="login-intro"><%= t('admin.loginIntro') %></p>

    <form action="/admin/login" method="post" class="login-form">
      <div class="form-field">
        <label class="field-label" for="username"><%= t('admin.username') %></label>
        <input class="field" id="username" name="username" autocomplete="username" required />
      </div>
      <div class="form-field">
        <label class="field-label" for="password"><%= t('admin.password') %></label>
        <input class="field" id="password" type="password" name="password" autocomplete="current-password" required />
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
      <p class="form-error" role="alert"><%= error %></p>
      <% } %>

      <button type="submit" class="btn btn--primary btn--block"><%= t('admin.loginButton') %></button>
    </form>

    <p class="login-helper"><%= t('admin.loginHelper') %></p>
  </div>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
