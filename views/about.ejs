<%- include('partials/header', { title: t('meta.aboutTitle'), page: 'about', baseUrl }) %>

<main id="main" class="container info-page">
  <p class="eyebrow"><%= t('about.eyebrow') %></p>
  <h1 class="h1-page"><%= t('about.title') %></h1>
  <p class="info-text"><%= t('about.p1') %></p>
  <p class="info-text info-text--muted"><%= t('about.p2') %></p>
  <p class="info-text info-text--muted"><%= t('about.p3') %></p>

  <section class="callout" aria-labelledby="feedback-heading">
    <h2 id="feedback-heading"><%= t('about.feedbackTitle') %></h2>
    <p><%= t('about.feedbackText') %></p>
  </section>
</main>

<%- include('partials/footer', { page: 'about' }) %>
