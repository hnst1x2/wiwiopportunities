<%- include('partials/header', { title: t('meta.archiveTitle'), page: 'archive', baseUrl }) %>

<main id="main" class="container archive-page">
  <p class="eyebrow"><%= t('archive.eyebrow') %></p>
  <h1 class="h1-page"><%= t('archive.title') %></h1>
  <p class="page-sub"><%= t('archive.sub') %></p>

  <%
    const archiveTypes = [
      ['Stage', 'options.types.stage'],
      ['Bourse', 'options.types.scholarship'],
      ['Volontariat', 'options.types.volunteering'],
      ['Job', 'options.types.job'],
      ['Études', 'options.types.studies'],
    ];
  %>
  <div class="archive-toolbar">
    <label for="search-alt" class="sr-only"><%= t('common.search') %></label>
    <input id="search-alt" type="search" class="field field--pill archive-search" placeholder="<%= t('archive.searchPlaceholder') %>" autocomplete="off" />
    <% archiveTypes.forEach(([value, labelKey]) => { %>
    <button type="button" class="chip" data-group="type" data-value="<%= value %>" aria-pressed="false"><%= t(labelKey) %></button>
    <% }) %>
    <span id="results-count" class="results-count" role="status" aria-live="polite">…</span>
  </div>

  <div id="opportunities-list" class="cards-grid cards-grid--archive"></div>
  <nav id="pagination" class="pagination" aria-label="<%= t('common.pagination') %>"></nav>
</main>

<script>
  window.__OPPS_STATUS__ = 'archived';
</script>

<%- include('partials/footer', { page: 'archive' }) %>
