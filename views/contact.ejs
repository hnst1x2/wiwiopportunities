<%- include('partials/header', { title: t('meta.contactTitle'), page: 'contact', baseUrl }) %>

<main class="main-layout">
  <section class="info-section">
    <div class="info-card">
      <h1><%= t('contact.title') %></h1>
      <p>
        <%= t('contact.intro') %>
      </p>
      <ul>
        <li><%= t('contact.offer') %></li>
        <li><%= t('contact.report') %></li>
        <li><%= t('contact.partner') %></li>
      </ul>

      <p>
        <strong><%= t('contact.emailLabel') %></strong>
        <a href="mailto:contact@wiwiopportunity.com">contact@wiwiopportunity.com</a>
      </p>

      <p>
        <%= t('contact.socialIntro') %>
      </p>
      <ul>
        <li><a href="<%= site.social.instagram %>" target="_blank">Instagram</a></li>
        <li><a href="<%= site.social.tiktok %>" target="_blank">TikTok</a></li>
        <li><a href="<%= site.social.linkedin %>" target="_blank">LinkedIn</a></li>
      </ul>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'contact' }) %>
