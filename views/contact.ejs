<%- include('partials/header', { title: t('meta.contactTitle'), page: 'contact', baseUrl }) %>

<main id="main" class="container info-page">
  <p class="eyebrow"><%= t('contact.eyebrow') %></p>
  <h1 class="h1-page"><%= t('contact.title') %></h1>
  <p class="info-text"><%= t('contact.intro') %></p>

  <ul class="check-list">
    <li><span class="check-icon" aria-hidden="true">✓</span><span><%= t('contact.offer') %></span></li>
    <li><span class="check-icon" aria-hidden="true">✓</span><span><%= t('contact.report') %></span></li>
    <li><span class="check-icon" aria-hidden="true">✓</span><span><%= t('contact.partner') %></span></li>
  </ul>

  <div class="contact-card">
    <div>
      <div class="micro-label"><%= t('contact.emailLabel') %></div>
      <a href="mailto:contact@wiwiopportunity.com" class="contact-email">contact@wiwiopportunity.com</a>
    </div>
    <div class="contact-social">
      <span class="contact-social-intro"><%= t('contact.socialIntro') %></span>
      <%- include('partials/social-icons') %>
    </div>
  </div>
</main>

<%- include('partials/footer', { page: 'contact' }) %>
