  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href="/" class="brand brand--dark" aria-label="<%= t('nav.brandLabel') %>">
          <img class="brand-mark" src="/img/opportunities-by-wiem-avatar.svg" alt="" width="30" height="30" />
          <span class="brand-word">Opportunities<span class="brand-word-accent"> by Wiem</span></span>
        </a>
        <p class="footer-tag"><%= t('footer.tag') %></p>
      </div>

      <nav class="footer-links" aria-label="<%= t('nav.footerLabel') %>">
        <a href="/"><%= t('nav.home') %></a>
        <a href="/#opps"><%= t('nav.opps') %></a>
        <a href="/archive"><%= t('nav.archive') %></a>
        <a href="/about"><%= t('nav.about') %></a>
        <a href="/contact"><%= t('nav.contact') %></a>
      </nav>

      <div class="footer-social">
        <%# resolved relative to this partial's directory %>
        <%- include('social-icons') %>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="container footer-bottom-inner">
        <span><%= t('footer.rights').replace('{year}', String(new Date().getFullYear())) %></span>
        <span><%= t('footer.made') %></span>
      </div>
    </div>
  </footer>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>
    <%# JSON embedded in a <script>: "<" is escaped so a "</script>" inside a string cannot break out. %>
    window.I18N = {
      lang: "<%= lang %>",
      strings: <%- JSON.stringify(i18n).replace(/</g, String.fromCharCode(92) + 'u003c') %>
    };
    (function () {
      var key = 'wiwi_lang';
      var current = "<%= lang %>";
      function setCookie(value) {
        document.cookie = 'wiwi_lang=' + encodeURIComponent(value) + '; Max-Age=31536000; Path=/; SameSite=Lax';
      }
      var stored = null;
      try {
        stored = localStorage.getItem(key);
      } catch (e) {}
      if (stored && stored !== current) {
        setCookie(stored);
        window.location.reload();
        return;
      }
      if (!stored) {
        try {
          localStorage.setItem(key, current);
        } catch (e) {}
        setCookie(current);
      }
      var buttons = document.querySelectorAll('[data-lang]');
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var lang = btn.getAttribute('data-lang');
          if (!lang || lang === current) return;
          try {
            localStorage.setItem(key, lang);
          } catch (e) {}
          setCookie(lang);
          window.location.reload();
        });
      });
    })();
  </script>

  <script src="/js/shared.js"></script>
  <% if (page === 'home' || page === 'archive') { %>
  <script src="/js/app.js"></script>
  <% } %>
  <% if (page === 'detail') { %>
  <script src="/js/detail.js"></script>
  <% } %>
  <% if (page === 'admin') { %>
  <script src="/js/admin.js"></script>
  <% } %>
</body>
</html>
