<!DOCTYPE html>
<html lang=\"fr\">
<head>
  <meta charset=\"UTF-8\" />
  <title><%= title || \"WiwiOpportunity – Opportunités à l'international\" %></title>
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />
  <meta name=\"description\" content=\"WiwiOpportunity recense des opportunités de stages, études, bourses et volontariats à l'international pour les étudiants et jeunes francophones.\" />

  <!-- OpenGraph / Social -->
  <meta property=\"og:title\" content=\"WiwiOpportunity – Opportunités à l'international\" />
  <meta property=\"og:description\" content=\"Trouve des stages, bourses, études et volontariats à l'étranger adaptés à ton profil.\" />
  <meta property=\"og:type\" content=\"website\" />
  <% if (baseUrl) { %>
    <meta property=\"og:url\" content=\"<%= baseUrl %>\" />
  <% } %>
  <meta property=\"og:image\" content=\"https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg\" />

  <link
    rel=\"stylesheet\"
    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\"
    integrity=\"sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==\"
    crossorigin=\"anonymous\"
    referrerpolicy=\"no-referrer\"
  />
  <link rel=\"stylesheet\" href=\"/css/base.css\" />
  <link rel=\"stylesheet\" href=\"/css/social.css\" />
  <% if (page === 'home') { %>
    <link rel=\"stylesheet\" href=\"/css/home.css\" />
  <% } %>
  <% if (page === 'detail') { %>
    <link rel=\"stylesheet\" href=\"/css/detail.css\" />
  <% } %>
  <% if (page === 'admin') { %>
    <link rel=\"stylesheet\" href=\"/css/admin.css\" />
  <% } %>
  <% if (page === 'about' || page === 'contact') { %>
    <link rel=\"stylesheet\" href=\"/css/info.css\" />
  <% } %>
</head>
<body>
  <header class=\"topbar\">
    <div class=\"topbar-inner\">
      <div class=\"logo\">
        <a href=\"/\" style=\"text-decoration:none;color:inherit;\">
          Wiwi<span>Opportunity</span>
        </a>
      </div>
      <nav class=\"nav-links\">
        <a href=\"/#opps\">Opportunités</a>
        <a href=\"/about\">À propos</a>
        <a href=\"/contact\">Contact</a>
        <a href=\"/#newsletter\" class=\"nav-cta\">Newsletter</a>
      </nav>
    </div>
  </header>
