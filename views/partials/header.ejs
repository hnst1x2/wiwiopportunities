<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <title><%= title || t('meta.defaultTitle') %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <% const pageDescription = (typeof metaDescription !== 'undefined' && metaDescription) || t('meta.defaultDescription'); %>
  <meta name="description" content="<%= pageDescription %>" />
  <meta name="keywords" content="<%= t('meta.keywords') %>" />
  <meta name="theme-color" content="#2e1451" />

  <!-- OpenGraph / Social -->
  <meta property="og:title" content="<%= title || t('meta.defaultTitle') %>" />
  <meta property="og:description" content="<%= (typeof metaDescription !== 'undefined' && metaDescription) || t('meta.ogDescription') %>" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Opportunities by Wiem" />
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>" />
  <meta property="og:url" content="<%= canonicalUrl %>" />
  <% } else if (typeof baseUrl !== 'undefined' && baseUrl) { %>
  <meta property="og:url" content="<%= baseUrl %>" />
  <% } %>
  <%# login/register render with page 'account', so they are covered too. %>
  <% const isPrivatePage = ['admin', 'admin-login', 'account', 'favorites'].includes(page); %>
  <% if (isPrivatePage) { %>
  <meta name="robots" content="noindex, nofollow" />
  <% } %>
  <meta property="og:image" content="<%= (typeof ogImage !== 'undefined' && ogImage) || 'https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg' %>" />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/img/opportunities-by-wiem-avatar.svg" />
  <link rel="preload" href="/fonts/Manrope-Regular.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/Manrope-ExtraBold.otf" as="font" type="font/otf" crossorigin />
  <link rel="stylesheet" href="/css/brand-tokens.css" />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/social.css" />
  <% if (page === 'home' || page === 'archive' || page === 'favorites') { %>
  <link rel="stylesheet" href="/css/home.css" />
  <% } %>
  <% if (page === 'account' || page === 'favorites') { %>
  <link rel="stylesheet" href="/css/account.css" />
  <% } %>
  <% if (page === 'detail') { %>
  <link rel="stylesheet" href="/css/detail.css" />
  <% } %>
  <% if (page === 'about' || page === 'contact') { %>
  <link rel="stylesheet" href="/css/info.css" />
  <% } %>
  <% if (page === 'admin') { %>
  <link rel="stylesheet" href="/css/admin.css" />
  <% } %>
  <% if (page !== 'admin' && page !== 'admin-login') { %>
  <link rel="stylesheet" href="/css/assistant.css" />
  <% } %>
  <% if (typeof gaMeasurementId !== 'undefined' && gaMeasurementId && !isPrivatePage) { %>
  <%# Google Analytics 4 (optional, GA_MEASUREMENT_ID): public pages only, no ads signals. %>
  <script async nonce="<%= cspNonce %>" src="https://www.googletagmanager.com/gtag/js?id=<%= encodeURIComponent(gaMeasurementId) %>"></script>
  <script nonce="<%= cspNonce %>">
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', <%- JSON.stringify(gaMeasurementId).replace(/</g, String.fromCharCode(92) + 'u003c') %>, { allow_google_signals: false, allow_ad_personalization_signals: false });
  </script>
  <% } %>
</head>
<body>
  <a class="skip-link" href="#main"><%= t('nav.skip') %></a>

  <header class="topbar">
    <div class="container topbar-inner">
      <a href="/" class="brand" aria-label="<%= t('nav.brandLabel') %>">
        <img class="brand-mark" src="/img/opportunities-by-wiem-avatar.svg" alt="" width="34" height="34" />
        <span class="brand-word">Opportunities<span class="brand-word-accent"> by Wiem</span></span>
      </a>

      <%
        const navItems = [
          { href: '/', key: 'home', label: t('nav.home') },
          { href: '/#opps', key: 'opps', label: t('nav.opps') },
          { href: '/archive', key: 'archive', label: t('nav.archive') },
          { href: '/about', key: 'about', label: t('nav.about') },
          { href: '/contact', key: 'contact', label: t('nav.contact') },
        ];
      %>
      <nav class="nav-links" aria-label="<%= t('nav.mainLabel') %>">
        <% navItems.forEach((item) => { const isActive = item.key === page; %>
        <a href="<%= item.href %>" class="nav-link<%= isActive ? ' is-active' : '' %>"<%- isActive ? ' aria-current="page"' : '' %>><%= item.label %></a>
        <% }) %>
      </nav>

      <div class="nav-tools">
        <div class="lang-switch" role="group" aria-label="<%= t('nav.langLabel') %>">
          <button type="button" class="lang-btn<%= lang === 'fr' ? ' is-active' : '' %>" data-lang="fr" aria-pressed="<%= lang === 'fr' %>" lang="fr">FR</button>
          <button type="button" class="lang-btn<%= lang === 'en' ? ' is-active' : '' %>" data-lang="en" aria-pressed="<%= lang === 'en' %>" lang="en">EN</button>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
        <a href="/favorites" class="nav-user-link" title="<%= t('account.navFavorites') %>">♥<span class="sr-only"> <%= t('account.navFavorites') %></span></a>
        <a href="/account" class="nav-user-link nav-user-link--account"><%= t('account.navAccount') %></a>
        <% } else { %>
        <a href="/login" class="nav-user-link nav-user-link--account"><%= t('account.navLogin') %></a>
        <% } %>
        <a href="/#newsletter" class="btn btn--accent btn--sm nav-cta"><%= t('nav.newsletter') %></a>
      </div>
    </div>
  </header>
