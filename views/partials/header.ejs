<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title><%= title || 'WiwiOpportunity - Opportunites internationales' %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="WiwiOpportunity recense des opportunites de stages, etudes, bourses et volontariats a l international pour les etudiants et jeunes francophones." />
  <meta name="keywords" content="stage, bourse, volontariat, etudes a l etranger, opportunites, jeunes, francophones" />

  <!-- OpenGraph / Social -->
  <meta property="og:title" content="<%= title || 'WiwiOpportunity - Opportunites internationales' %>" />
  <meta property="og:description" content="Trouve des stages, bourses, etudes et volontariats a l etranger adaptes a ton profil." />
  <meta property="og:type" content="website" />
  <!-- Mets ton image OG ici si tu veux -->
  <meta property="og:image" content="https://images.pexels.com/photos/1181675/pexels-photo-1181675.jpeg" />
  <meta name="twitter:card" content="summary_large_image" />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
    crossorigin="anonymous"
    referrerpolicy="no-referrer"
  />
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/social.css" />
  <% if (page === 'home') { %>
    <link rel="stylesheet" href="/css/home.css" />
  <% } %>
  <% if (page === 'detail') { %>
    <link rel="stylesheet" href="/css/detail.css" />
  <% } %>
  <% if (page === 'admin') { %>
    <link rel="stylesheet" href="/css/admin.css" />
  <% } %>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <div class="logo">
        <a href="/" style="text-decoration:none;color:inherit;">
          Wiwi<span>Opportunity</span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/#opps">Opportunites</a>
        <a href="/about">A propos</a>
        <a href="/#newsletter" class="nav-cta">Newsletter</a>
      </nav>
    </div>
  </header>
