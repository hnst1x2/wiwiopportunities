<%
  // Brand social icons (Instagram / TikTok / LinkedIn). URLs from server/config/site.js.
  // Inline SVG glyphs on brand-colored chips — no icon-font dependency. Accessible via aria-label.
%>
<div class="social-icons">
  <a href="<%= site.social.instagram %>" class="social-icon social-icon--instagram" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="5" fill="none" stroke="currentColor" stroke-width="2"></rect>
      <circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <circle cx="16.6" cy="7.4" r="1.15" fill="currentColor"></circle>
    </svg>
  </a>
  <a href="<%= site.social.tiktok %>" class="social-icon social-icon--tiktok" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M15.6 3.2c.36 1.86 1.62 3.38 3.6 3.6v2.72c-1.3 0-2.5-.42-3.6-1.13v5.6c0 2.9-2.3 5.24-5.14 5.24S5.32 17 5.32 14.1c0-2.9 2.3-5.24 5.14-5.24.28 0 .55.02.82.07v2.84a2.5 2.5 0 0 0-.82-.14c-1.34 0-2.43 1.13-2.43 2.53s1.09 2.53 2.43 2.53c1.35 0 2.44-1.13 2.44-2.53V3.2h2.7z"></path>
    </svg>
  </a>
  <a href="<%= site.social.linkedin %>" class="social-icon social-icon--linkedin" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M6.94 7.5a1.94 1.94 0 1 1 0-3.88 1.94 1.94 0 0 1 0 3.88zM5.3 9h3.3v10.5H5.3V9zm5.4 0h3.16v1.44h.05c.44-.83 1.52-1.71 3.13-1.71 3.35 0 3.96 2.2 3.96 5.06v5.71h-3.28v-5.06c0-1.21-.02-2.76-1.68-2.76-1.69 0-1.95 1.32-1.95 2.68v5.14H10.7V9z"></path>
    </svg>
  </a>
</div>
