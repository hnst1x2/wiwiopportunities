<% const section = typeof adminSection !== 'undefined' ? adminSection : 'opps'; %>
<div class="admin-header">
  <div>
    <p class="eyebrow"><%= t('admin.eyebrow') %></p>
    <h1 class="admin-title"><%= t('admin.title') %></h1>
    <p class="admin-intro"><%= t('admin.intro') %></p>
  </div>
  <div class="admin-header-actions">
    <a href="/admin/new" class="btn btn--accent btn--sm"><%= t('admin.addNew') %></a>
    <form action="/admin/logout" method="post">
      <button type="submit" class="btn btn--ghost btn--sm"><%= t('admin.logout') %></button>
    </form>
  </div>
</div>

<nav class="admin-nav" aria-label="<%= t('admin.nav.label') %>">
  <% [['opps', '/admin'], ['users', '/admin/users'], ['stats', '/admin/stats']].forEach(([key, href]) => { const isActive = key === section; %>
  <a href="<%= href %>" class="admin-nav-link<%= isActive ? ' is-active' : '' %>"<%- isActive ? ' aria-current="page"' : '' %>><%= t('admin.nav.' + key) %></a>
  <% }) %>
</nav>
