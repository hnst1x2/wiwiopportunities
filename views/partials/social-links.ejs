<%
  // Renders the three social links (URLs from server/config/site.js).
  // Pass { separator: '·' } to print a separator between links (inline contexts).
  const socialLinks = [
    { href: site.social.instagram, label: 'Instagram' },
    { href: site.social.tiktok, label: 'TikTok' },
    { href: site.social.linkedin, label: 'LinkedIn' },
  ];
  const socialSeparator = typeof separator === 'string' ? separator : '';
%>
<% socialLinks.forEach((link, index) => { %><% if (index > 0 && socialSeparator) { %><span class="social-sep" aria-hidden="true"><%= socialSeparator %></span><% } %><a href="<%= link.href %>" class="social-link" target="_blank" rel="noopener noreferrer"><%= link.label %></a>
<% }) %>
