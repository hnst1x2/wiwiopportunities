<%- include('partials/header', { title: 'Administration – Opportunites', page: 'admin' }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
        <h1 style="margin:0;">Administration – Opportunites</h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a href="/" class="btn-secondary">← Retour au site</a>
          <a href="/admin/new" class="btn-primary">+ Nouvelle opportunite</a>
        </div>
      </div>

      <div class="admin-table-wrapper">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Titre</th>
              <th>Pays</th>
              <th>Type</th>
              <th>Domaine</th>
              <th>Deadline</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!opportunities.length) { %>
              <tr>
                <td colspan="7">Aucune opportunite pour le moment.</td>
              </tr>
            <% } %>
            <% opportunities.forEach(function(o) { %>
              <tr>
                <td><%= o.id %></td>
                <td>
                  <%= o.title %>
                  <% if (o.featured) { %>
                    <span title="Mise en avant" style="color:#f59e0b;margin-left:4px;">★</span>
                  <% } %>
                </td>
                <td><%= o.country || '' %></td>
                <td><%= o.type || '' %></td>
                <td><%= o.domain || '' %></td>
                <td><%= o.deadline || '' %></td>
                <td class="admin-actions-cell">
                  <a href="/admin/opportunities/<%= o.id %>/edit" class="btn-secondary btn-sm">Modifier</a>
                  <form action="/admin/opportunities/<%= o.id %>...e;" onsubmit="return confirm('Supprimer cette opportunite ?');">
                    <button type="submit" class="btn-primary btn-sm" style="background:#dc2626;">Supprimer</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
