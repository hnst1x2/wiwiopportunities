<%- include('partials/header', { title: "Administration – Opportunités", page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
        <h1 style="margin:0;">Administration – Opportunités</h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a href="/admin/new" class="btn-primary">+ Nouvelle opportunité</a>
          <form action="/admin/logout" method="post">
            <button type="submit" class="btn-secondary">Se déconnecter</button>
          </form>
        </div>
      </div>

      <p class="admin-intro">
        Liste des opportunités actuelles. Tu peux les modifier ou les supprimer.
      </p>

      <% if (!opportunities.length) { %>
        <p>Aucune opportunité pour le moment.</p>
      <% } else { %>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Titre</th>
                <th>Pays</th>
                <th>Type</th>
                <th>Financement</th>
                <th>Deadline</th>
                <th>Tags</th>
                <th style="width:140px;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% opportunities.forEach(function(o) { %>
                <tr>
                  <td><%= o.title %></td>
                  <td><%= o.country || "" %></td>
                  <td><%= o.type || "" %></td>
                  <td><%= o.funding || "" %></td>
                  <td><%= o.deadline || "" %></td>
                  <td>
                    <% if (Array.isArray(o.tags)) { %>
                      <%= o.tags.join(", ") %>
                    <% } %>
                  </td>
                  <td>
                    <div class="admin-actions-row">
                      <a href="/admin/edit/<%= o.id %>" class="btn-secondary btn-sm">Éditer</a>
                      <form action="/admin/delete/<%= o.id %>" method="post" onsubmit="return confirm('Supprimer cette opportunité ?');">
                        <button type="submit" class="btn-secondary btn-sm" style="border-color:#fecaca;background:#fef2f2;color:#b91c1c;">
                          Supprimer
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
