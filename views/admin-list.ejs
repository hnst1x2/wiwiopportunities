<%- include('partials/header', { title: "Administration – Opportunités", page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
        <h1 style="margin:0;">Administration – Opportunités</h1>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <a href="/admin/new" class="btn-primary">+ Nouvelle opportunité</a>
          <form action="/admin/logout" method="post">
            <button type="submit" class="btn-secondary">Se déconnecter</button>
          </form>
        </div>
      </div>

      <p class="admin-intro">
        Liste des opportunités actuelles. Tu peux les modifier ou les supprimer.
      </p>

      <div class="admin-filters" id="admin-filters">
        <div class="filter-group">
          <label for="admin-search">Recherche</label>
          <input id="admin-search" type="text" placeholder="Titre, orga, pays, tags..." />
        </div>
        <div class="filter-group">
          <label for="admin-country">Pays</label>
          <select id="admin-country">
            <option value="">Tous</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="admin-type">Type</label>
          <select id="admin-type">
            <option value="">Tous</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="admin-funding">Financement</label>
          <select id="admin-funding">
            <option value="">Tous</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="admin-featured">Mise en avant</label>
          <select id="admin-featured">
            <option value="">Tous</option>
            <option value="true">Oui</option>
            <option value="false">Non</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="admin-tag">Tag</label>
          <input id="admin-tag" type="text" placeholder="ex : Marketing" />
        </div>
        <div class="filter-actions">
          <button id="admin-reset" class="btn-secondary btn-sm" type="button">Réinitialiser</button>
        </div>
      </div>

      <div class="admin-results-meta">
        <span id="admin-results-count"></span>
      </div>

      <% if (!opportunities.length) { %>
        <p>Aucune opportunité pour le moment.</p>
      <% } else { %>
        <div class="admin-table-wrapper">
          <table class="admin-table" id="admin-table">
            <thead>
              <tr>
                <th data-sort="title">Titre</th>
                <th data-sort="country">Pays</th>
                <th data-sort="type">Type</th>
                <th data-sort="funding">Financement</th>
                <th data-sort="deadline">Deadline</th>
                <th data-sort="tags">Tags</th>
                <th style="width:140px;">Actions</th>
              </tr>
            </thead>
            <tbody id="admin-table-body"></tbody>
          </table>
        </div>
        <div id="admin-pagination" class="admin-pagination"></div>
      <% } %>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>

<script>
  window.__ADMIN_OPPORTUNITIES__ = <%- JSON.stringify(opportunities || []) %>;
</script>
