<%- include('partials/header', { title: t('meta.adminListTitle'), page: 'admin', baseUrl }) %>

<main id="main" class="container admin-page">
  <%- include('partials/admin-header') %>

  <div class="admin-list">
    <div class="admin-toolbar">
      <label for="admin-search" class="sr-only"><%= t('admin.search') %></label>
      <input id="admin-search" type="search" class="field field--pill admin-search" placeholder="<%= t('admin.searchPlaceholder') %>" autocomplete="off" />
      <span id="admin-results-count" class="admin-count" role="status" aria-live="polite"></span>
      <span id="admin-message" class="admin-message" role="status" aria-live="polite"></span>
    </div>

    <% if (!opportunities.length) { %>
    <p class="admin-empty"><%= t('admin.none') %></p>
    <% } else { %>
    <div class="admin-table-wrap">
      <div class="admin-table" role="table" aria-label="<%= t('admin.tableLabel') %>">
        <div class="admin-row admin-row--head" role="row">
          <span role="columnheader"><%= t('admin.table.title') %></span>
          <span role="columnheader"><%= t('admin.table.country') %></span>
          <span role="columnheader"><%= t('admin.table.type') %></span>
          <span role="columnheader"><%= t('admin.table.deadline') %></span>
          <span role="columnheader"><%= t('admin.table.featured') %></span>
          <span role="columnheader"><%= t('admin.table.actions') %></span>
        </div>
        <div id="admin-table-body" role="rowgroup"></div>
      </div>
    </div>
    <% } %>
  </div>
</main>

<script>
  <%# "<" is escaped so a "</script>" inside a record cannot break out of this tag. %>
  window.__ADMIN_OPPORTUNITIES__ = <%- JSON.stringify(opportunities || []).replace(/</g, String.fromCharCode(92) + 'u003c') %>;
</script>

<%- include('partials/footer', { page: 'admin' }) %>
