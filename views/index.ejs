<%- include('partials/header', { title: t('meta.homeTitle'), page: 'home' }) %>

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1><%= t('home.heroTitle') %></h1>
    <p>
      <%= t('home.heroText') %>
    </p>

    <div class="hero-search">
      <div class="hero-search-input">
        <input
          type="text"
          id="search"
          placeholder="<%= t('home.heroSearchPlaceholder') %>"
        />
      </div>
      <button id="btn-hero-search"><%= t('home.heroSearchButton') %></button>
    </div>

    <div class="hero-tags">
      <span><%= t('home.suggestionsLabel') %></span>
      <button class="chip" data-type="Stage"><%= t('home.chips.stage') %></button>
      <button class="chip" data-type="Bourse"><%= t('home.chips.scholarship') %></button>
      <button class="chip" data-type="Volontariat"><%= t('home.chips.volunteering') %></button>
      <button class="chip" data-country="France"><%= t('home.chips.france') %></button>
      <button class="chip" data-country="Allemagne"><%= t('home.chips.germany') %></button>
    </div>

    <div class="social-cta-bar">
      <span class="social-cta-text"><%= t('home.socialCta') %></span>
      <div class="social-cta-links">
        <%- include('partials/social-links') %>
      </div>
    </div>
  </div>
</section>

<section class="featured-section">
  <div class="main-layout">
    <div class="featured-header">
      <div>
        <h2><%= t('home.featuredTitle') %></h2>
        <p class="featured-subtitle">
          <%= t('home.featuredSubtitle') %>
        </p>
      </div>
      <p class="featured-hint">
        <%= t('home.featuredHint') %>
      </p>
    </div>
    <div id="featured-list" class="featured-cards">
      <!-- cartes mises en avant generees par JS -->
    </div>
  </div>
</section>


<main class="main-layout">
  <section id="opps" class="opportunities-section">
    <div class="layout-grid">
      <aside class="filters-panel">
        <h2><%= t('home.filtersTitle') %></h2>

        <div class="filter-group">
          <label for="filter-country"><%= t('filters.country') %></label>
          <select id="filter-country">
            <option value=""><%= t('filters.allCountries') %></option>
            <option value="France"><%= t('options.countries.france') %></option>
            <option value="Allemagne"><%= t('options.countries.germany') %></option>
            <option value="Maroc"><%= t('options.countries.morocco') %></option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-type"><%= t('filters.type') %></label>
          <select id="filter-type">
            <option value=""><%= t('filters.allTypes') %></option>
            <option value="Stage"><%= t('options.types.stage') %></option>
            <option value="Bourse"><%= t('options.types.scholarship') %></option>
            <option value="Volontariat"><%= t('options.types.volunteering') %></option>
            <option value="Job"><%= t('options.types.job') %></option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-funding"><%= t('filters.funding') %></label>
          <select id="filter-funding">
            <option value=""><%= t('filters.allFunding') %></option>
            <option value="Fully funded"><%= t('options.funding.fully') %></option>
            <option value="Partially funded"><%= t('options.funding.partial') %></option>
            <option value="Non finance"><%= t('options.funding.none') %></option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-tag"><%= t('filters.domain') %></label>
          <select id="filter-tag">
            <option value=""><%= t('filters.allDomains') %></option>
            <option value="IT"><%= t('options.domains.it') %></option>
            <option value="Marketing"><%= t('options.domains.marketing') %></option>
            <option value="Business"><%= t('options.domains.business') %></option>
            <option value="Etudes"><%= t('options.domains.studies') %></option>
            <option value="Humanitaire"><%= t('options.domains.humanitarian') %></option>
          </select>
        </div>

        <button id="btn-reset" class="btn-secondary full-width"><%= t('common.reset') %></button>
        <p class="filters-hint">
          <%= t('home.filtersHint') %>
        </p>
      </aside>

      <section class="results-panel">
        <div class="results-header">
          <h2><%= t('home.resultsTitle') %></h2>
          <div class="results-meta">
            <span id="results-count"><%= t('common.loading') %></span>
          </div>
        </div>

        <div id="opportunities-list" class="cards-container">
          <!-- cartes generees par app.js -->
        </div>

        <div id="pagination" class="pagination-bar"></div>
      </section>
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="about-card">
      <h2><%= t('home.aboutTitle') %></h2>
      <p>
        <%= t('home.aboutText') %>
      </p>
    </div>
  </section>

  <section id="newsletter" class="newsletter-section">
    <div class="newsletter-card">
      <h2><%= t('home.newsletterTitle') %></h2>
      <p>
        <%= t('home.newsletterText') %>
      </p>
      <form id="newsletter-form" class="newsletter-form">
        <input type="email" id="newsletter-email" placeholder="<%= t('home.newsletterPlaceholder') %>" required />
        <button class="btn-primary" type="submit"><%= t('home.newsletterButton') %></button>
      </form>
      <p class="newsletter-note" id="newsletter-message"></p>

      <div class="social-inline-note">
        <%= t('home.socialInlineLead') %>
        <a href="<%= site.social.instagram %>" target="_blank">Instagram</a>,
        <a href="<%= site.social.tiktok %>" target="_blank">TikTok</a>
        <%= t('common.and') %>
        <a href="<%= site.social.linkedin %>" target="_blank">LinkedIn</a>.
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'home' }) %>
