<%- include('partials/header', { title: 'WiwiOpportunity – Opportunites internationales', page: 'home' }) %>

<section class="hero">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1>Decouvre des opportunites de stages, bourses, etudes et volontariats a l'international.</h1>
    <p>
      WiwiOpportunity aide les etudiants et jeunes francophones a trouver des experiences
      marquantes : stages a l'etranger, bourses, volontariats, jobs et plus encore.
    </p>

    <div class="hero-search">
      <div class="hero-search-input">
        <input
          type="text"
          id="search"
          placeholder="Rechercher une opportunite (ex : stage marketing Berlin, bourse France...)"
        />
      </div>
      <button id="btn-hero-search">Rechercher</button>
    </div>

    <div class="hero-tags">
      <span>Suggestions :</span>
      <button class="chip" data-type="Stage">Stages</button>
      <button class="chip" data-type="Bourse">Bourses</button>
      <button class="chip" data-type="Volontariat">Volontariats</button>
      <button class="chip" data-country="France">France</button>
      <button class="chip" data-country="Allemagne">Allemagne</button>
    </div>

    <div class="social-cta-bar">
      <span class="social-cta-text">Suivez WiwiOpportunity sur les reseaux :</span>
      <div class="social-cta-links">
        <a href="https://www.instagram.com/wiwiopportunity" target="_blank" class="social-pill insta">
          <i class="fa-brands fa-instagram"></i><span>Instagram</span>
        </a>
        <a href="https://www.tiktok.com/@wiwiopportunity" target="_blank" class="social-pill tiktok">
          <i class="fa-brands fa-tiktok"></i><span>TikTok</span>
        </a>
        <a href="https://www.linkedin.com/company/wiwiopportunity" target="_blank" class="social-pill linkedin">
          <i class="fa-brands fa-linkedin"></i><span>LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="featured-section">
  <div class="main-layout">
    <div class="featured-header">
      <div>
        <h2>Opportunites mises en avant</h2>
        <p class="featured-subtitle">
          Une selection rapide d opportunites interessantes choisies manuellement dans le back-office.
        </p>
      </div>
      <p class="featured-hint">Tu peux gerer cette selection dans l espace admin (case "Mettre en avant").</p>
    </div>
    <div id="featured-list" class="featured-cards">
      <!-- cartes mises en avant generees par JS -->
    </div>
  </div>
</section>

<main class="main-layout">
  <section id="opps" class="opportunities-section">
    <div class="layout-grid">
      <aside class="filters-panel">
        <h2>Filtrer les opportunites</h2>

        <div class="filter-group">
          <label for="filter-country">Pays</label>
          <select id="filter-country">
            <option value="">Tous les pays</option>
            <option value="France">France</option>
            <option value="Allemagne">Allemagne</option>
            <option value="Maroc">Maroc</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-type">Type d'opportunite</label>
          <select id="filter-type">
            <option value="">Tous les types</option>
            <option value="Stage">Stage</option>
            <option value="Bourse">Bourse</option>
            <option value="Volontariat">Volontariat</option>
            <option value="Job">Job</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-funding">Financement</label>
          <select id="filter-funding">
            <option value="">Tous les financements</option>
            <option value="Fully funded">Fully funded</option>
            <option value="Partially funded">Partially funded</option>
            <option value="Non financé">Non financé</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-domain">Domaine</label>
          <select id="filter-domain">
            <option value="">Tous les domaines</option>
            <option value="IT">IT / Tech</option>
            <option value="Marketing">Marketing / Communication</option>
            <option value="Business">Business / Management</option>
            <option value="Etudes">Etudes / Academique</option>
            <option value="Humanitaire">Humanitaire / Social</option>
          </select>
        </div>

        <button id="btn-reset" class="btn-secondary full-width">Reinitialiser les filtres</button>
        <p class="filters-hint">
          Astuce : tu peux combiner la recherche texte (en haut) avec les filtres ci-dessus.
        </p>
      </aside>

      <section class="results-panel">
        <div class="results-header">
          <h2>Opportunites disponibles</h2>
          <div class="results-meta">
            <span id="results-count">Chargement...</span>
          </div>
        </div>

        <div id="opportunities-list" class="cards-container">
          <!-- cartes generees par app.js -->
        </div>

        <div id="pagination" class="pagination">
          <button id="prev-page" disabled>Precedent</button>
          <span id="page-info">Page 1 / 1</span>
          <button id="next-page" disabled>Suivant</button>
        </div>
      </section>
    </div>
  </section>

  <section id="about" class="about-section">
    <div class="about-card">
      <h2>A propos de WiwiOpportunity</h2>
      <p>
        WiwiOpportunity est une plateforme independante pour rendre plus accessibles les
        opportunites a l'international pour les jeunes francophones.
      </p>
    </div>
  </section>

  <section id="newsletter" class="newsletter-section">
    <div class="newsletter-card">
      <h2>Reste informe(e)</h2>
      <p>
        Inscris-toi pour recevoir prochainement une selection d'opportunites adaptees a ton profil.
      </p>
      <form id="newsletter-form" class="newsletter-form">
        <input type="email" id="newsletter-email" placeholder="Ton email" required />
        <button class="btn-primary" type="submit">S'inscrire</button>
      </form>
      <p class="newsletter-note" id="newsletter-message"></p>

      <div class="social-inline-note">
        En attendant, on partage deja des opportunites sur
        <a href="https://www.instagram.com/wiwiopportunity" target="_blank">Instagram</a>,
        <a href="https://www.tiktok.com/@wiwiopportunity" target="_blank">TikTok</a> et
        <a href="https://www.linkedin.com/company/wiwiopportunity" target="_blank">LinkedIn</a>.
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'home' }) %>
