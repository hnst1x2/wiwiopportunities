<%- include('partials/header', { title: t('meta.homeTitle'), page: 'home' }) %>

<main id="main">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-blob hero-blob--1" aria-hidden="true"></div>
    <div class="hero-blob hero-blob--2" aria-hidden="true"></div>
    <div class="hero-inner">
      <p class="eyebrow eyebrow--light"><%= t('hero.eyebrow') %></p>
      <h1 id="hero-heading" class="hero-title"><%= t('hero.title1') %> <span class="text-gradient"><%= t('hero.titleAccent') %></span></h1>
      <p class="hero-sub"><%= t('hero.sub') %></p>

      <form class="hero-search" id="hero-search-form" role="search">
        <label for="search" class="sr-only"><%= t('common.search') %></label>
        <input type="search" id="search" class="hero-search-input" placeholder="<%= t('hero.placeholder') %>" autocomplete="off" />
        <button type="submit" class="btn btn--primary hero-search-btn" id="btn-hero-search"><%= t('hero.button') %></button>
      </form>

      <div class="hero-chips">
        <span class="hero-chips-label"><%= t('hero.suggestions') %></span>
        <button type="button" class="hero-chip" data-type="Stage"><%= t('hero.chips.stage') %></button>
        <button type="button" class="hero-chip" data-type="Bourse"><%= t('hero.chips.scholarship') %></button>
        <button type="button" class="hero-chip" data-type="Volontariat"><%= t('hero.chips.volunteering') %></button>
        <button type="button" class="hero-chip" data-country="France"><%= t('hero.chips.france') %></button>
        <button type="button" class="hero-chip" data-country="Allemagne"><%= t('hero.chips.germany') %></button>
      </div>

      <div class="hero-social">
        <span class="hero-social-label"><%= t('hero.social') %></span>
        <%- include('partials/social-links') %>
      </div>
    </div>
  </section>

  <%# Shown by app.js only when at least one active opportunity is flagged "featured" in the back-office %>
  <section id="featured" class="container section featured-section" aria-labelledby="featured-heading" hidden>
    <p class="eyebrow"><%= t('featured.eyebrow') %></p>
    <h2 id="featured-heading" class="h2-section"><%= t('featured.title') %></h2>
    <p class="section-sub"><%= t('featured.sub') %></p>
    <div id="featured-list" class="featured-grid"></div>
  </section>

  <section id="opps" class="container section opps-section" aria-labelledby="opps-heading">
    <p class="eyebrow"><%= t('list.eyebrow') %></p>
    <h2 id="opps-heading" class="h2-section"><%= t('list.title') %></h2>

    <%
      // Chip values are the stored data values (type) or normalized keys (funding, domain).
      const chipGroups = [
        {
          key: 'type',
          values: [
            ['Stage', 'options.types.stage'],
            ['Bourse', 'options.types.scholarship'],
            ['Volontariat', 'options.types.volunteering'],
            ['Job', 'options.types.job'],
            ['Études', 'options.types.studies'],
          ],
        },
        {
          key: 'funding',
          values: [
            ['fully', 'options.funding.fully'],
            ['partial', 'options.funding.partial'],
            ['none', 'options.funding.none'],
          ],
        },
        {
          key: 'domain',
          values: [
            ['it', 'options.domains.it'],
            ['marketing', 'options.domains.marketing'],
            ['business', 'options.domains.business'],
            ['studies', 'options.domains.studies'],
            ['humanitarian', 'options.domains.humanitarian'],
          ],
        },
      ];
    %>
    <div class="filters-panel">
      <div class="filters-row">
        <label for="search-alt" class="sr-only"><%= t('common.search') %></label>
        <input id="search-alt" type="search" class="field field--pill filters-search" placeholder="<%= t('list.searchPlaceholder') %>" autocomplete="off" />
        <label for="filter-country" class="sr-only"><%= t('list.country') %></label>
        <select id="filter-country" class="field field--pill filters-country">
          <option value=""><%= t('list.allCountries') %></option>
        </select>
      </div>

      <% chipGroups.forEach((group) => { %>
      <div class="chip-group" role="group" aria-label="<%= t('list.groups.' + group.key) %>">
        <span class="chip-group-label"><%= t('list.groups.' + group.key) %></span>
        <% group.values.forEach(([value, labelKey]) => { %>
        <button type="button" class="chip" data-group="<%= group.key %>" data-value="<%= value %>" aria-pressed="false"><%= t(labelKey) %></button>
        <% }) %>
      </div>
      <% }) %>
    </div>

    <div class="results-row">
      <span id="results-count" class="results-count" role="status" aria-live="polite">…</span>
      <button type="button" id="btn-clear" class="btn-clear" hidden>✕ <%= t('list.clear') %></button>
      <span class="results-hint"><%= t('list.hint') %></span>
    </div>

    <div id="opportunities-list" class="cards-grid"></div>
    <nav id="pagination" class="pagination" aria-label="<%= t('common.pagination') %>"></nav>
  </section>

  <section id="newsletter" class="container newsletter-section" aria-labelledby="newsletter-heading">
    <div class="newsletter-card">
      <p class="eyebrow eyebrow--soft"><%= t('newsletter.eyebrow') %></p>
      <h2 id="newsletter-heading" class="newsletter-title"><%= t('newsletter.title') %></h2>
      <p class="newsletter-text"><%= t('newsletter.text') %></p>
      <form id="newsletter-form" class="newsletter-form" novalidate>
        <label for="newsletter-email" class="sr-only"><%= t('common.email') %></label>
        <input type="email" id="newsletter-email" name="email" placeholder="<%= t('newsletter.placeholder') %>" autocomplete="email" required />
        <button type="submit" class="btn btn--primary"><%= t('newsletter.button') %></button>
      </form>
      <p id="newsletter-message" class="newsletter-status" role="status" aria-live="polite"></p>
      <p class="newsletter-social"><%= t('newsletter.lead') %> <%- include('partials/social-links', { separator: '·' }) %></p>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'home' }) %>
