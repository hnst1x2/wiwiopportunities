<%- include('partials/header', { title: t('meta.adminNewTitle'), page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <h1><%= t('admin.newTitle') %></h1>
      <p class="admin-intro">
        <%= t('admin.newIntro') %> <code>opportunities.json</code>.
      </p>

      <form action="/admin/new" method="post" class="admin-form">
        <div class="admin-grid">

          <div class="form-group">
            <label>
              <input type="checkbox" name="featured" value="1" />
              <%= t('admin.featuredLabel') %>
            </label>
          </div>

          <div class="form-group">
            <label for="title"><%= t('admin.fields.title') %> <span class="required">*</span></label>
            <input type="text" id="title" name="title" required />
          </div>

          <div class="form-group">
            <label for="organization"><%= t('admin.fields.organization') %></label>
            <input type="text" id="organization" name="organization" />
          </div>

          <div class="form-group">
            <label for="country"><%= t('admin.fields.country') %> <span class="required">*</span></label>
            <input type="text" id="country" name="country" required />
          </div>

          <div class="form-group">
            <label for="city"><%= t('admin.fields.city') %></label>
            <input type="text" id="city" name="city" />
          </div>

          <div class="form-group">
            <label for="type"><%= t('admin.fields.type') %> <span class="required">*</span></label>
            <select id="type" name="type" required>
              <option value=""><%= t('common.select') %>...</option>
              <option value="Stage"><%= t('options.types.stage') %></option>
              <option value="Bourse"><%= t('options.types.scholarship') %></option>
              <option value="Volontariat"><%= t('options.types.volunteering') %></option>
              <option value="Job"><%= t('options.types.job') %></option>
            </select>
          </div>

          <div class="form-group">
            <label for="funding"><%= t('admin.fields.funding') %></label>
            <select id="funding" name="funding">
              <option value=""><%= t('options.funding.unspecified') %></option>
              <option value="Fully funded"><%= t('options.funding.fully') %></option>
              <option value="Partially funded"><%= t('options.funding.partial') %></option>
              <option value="Non finance"><%= t('options.funding.none') %></option>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline"><%= t('admin.fields.deadline') %></label>
            <input type="date" id="deadline" name="deadline" />
          </div>

          <div class="form-group">
            <label for="duration"><%= t('admin.fields.duration') %></label>
            <input type="text" id="duration" name="duration" placeholder="<%= t('admin.placeholders.duration') %>" />
          </div>

          <div class="form-group">
            <label for="link"><%= t('admin.fields.link') %></label>
            <input type="url" id="link" name="link" placeholder="<%= t('admin.placeholders.link') %>" />
          </div>

          <div class="form-group">
            <label for="tags"><%= t('admin.fields.tags') %></label>
            <input type="text" id="tags" name="tags" placeholder="<%= t('admin.placeholders.tags') %>" />
          </div>
        </div>

        <div class="form-group">
          <label for="description"><%= t('admin.fields.description') %></label>
          <textarea id="description" name="description" rows="4" placeholder="<%= t('admin.placeholders.description') %>"></textarea>
        </div>

        <div class="form-group">
          <label for="extra"><%= t('admin.fields.extra') %></label>
          <textarea id="extra" name="extra" rows="4" placeholder="<%= t('admin.placeholders.extra') %>"></textarea>
        </div>

        <div class="admin-actions">
          <a href="/admin" class="btn-secondary"><%= t('common.cancel') %></a>
          <button type="submit" class="btn-primary"><%= t('admin.save') %></button>
        </div>

        <p class="admin-note">
          <span class="required">*</span> <%= t('admin.requiredNote') %>
        </p>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
