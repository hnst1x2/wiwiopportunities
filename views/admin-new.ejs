<%- include('partials/header', { title: 'Ajouter une opportunite – WiwiOpportunity', page: 'admin' }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <h1>Ajouter une nouvelle opportunite</h1>
      <p class="admin-intro">
        Utilise ce formulaire pour ajouter une opportunite (stage, bourse, volontariat, job).
      </p>

      <form action="/admin/new" method="post" class="admin-form">
        <div class="admin-grid">
          <div class="form-group">
            <label for="title">Titre <span class="required">*</span></label>
            <input type="text" id="title" name="title" required />
          </div>

          <div class="form-group">
            <label for="organization">Organisation</label>
            <input type="text" id="organization" name="organization" />
          </div>

          <div class="form-group">
            <label for="country">Pays <span class="required">*</span></label>
            <input type="text" id="country" name="country" required />
          </div>

          <div class="form-group">
            <label for="city">Ville</label>
            <input type="text" id="city" name="city" />
          </div>

          <div class="form-group">
            <label for="type">Type d'opportunite <span class="required">*</span></label>
            <select id="type" name="type" required>
              <option value="">Choisir...</option>
              <option value="Stage">Stage</option>
              <option value="Bourse">Bourse</option>
              <option value="Volontariat">Volontariat</option>
              <option value="Job">Job</option>
            </select>
          </div>

          <div class="form-group">
            <label for="funding">Financement</label>
            <select id="funding" name="funding">
              <option value="">Non specifie</option>
              <option value="Fully funded">Fully funded</option>
              <option value="Partially funded">Partially funded</option>
              <option value="Non finance">Non finance</option>
            </select>
          </div>

          <div class="form-group">
            <label for="domain">Domaine</label>
            <select id="domain" name="domain">
              <option value="">Non specifie</option>
              <option value="IT">IT / Tech</option>
              <option value="Marketing">Marketing / Communication</option>
              <option value="Business">Business / Management</option>
              <option value="Etudes">Etudes / Academique</option>
              <option value="Humanitaire">Humanitaire / Social</option>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline">Deadline</label>
            <input type="date" id="deadline" name="deadline" />
          </div>

          <div class="form-group">
            <label for="duration">Duree</label>
            <input type="text" id="duration" name="duration" />
          </div>

          <div class="form-group">
            <label for="link">Lien de candidature</label>
            <input type="url" id="link" name="link" />
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4"></textarea>
        </div>

        <div class="form-group">
          <label for="extra">Profil / Conditions / Infos complementaires</label>
          <textarea id="extra" name="extra" rows="4"></textarea>
        
        <div class="form-group">
          <label>
            <input type="checkbox" name="featured" value="1" />
            Mettre cette opportunite en avant (section mise en avant sur la page d accueil)
          </label>
        </div>
</div>

        <div class="admin-actions">
          <a href="/admin/opportunities" class="btn-secondary">Annuler</a>
          <button type="submit" class="btn-primary">Enregistrer l'opportunite</button>
        </div>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
