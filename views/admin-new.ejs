<%- include('partials/header', { title: "Ajouter une opportunité – WiwiOpportunity", page: 'admin', baseUrl }) %>

<main class="main-layout">
  <section class="admin-section">
    <div class="admin-form-card">
      <h1>Ajouter une nouvelle opportunité</h1>
      <p class="admin-intro">
        Les données seront enregistrées dans le fichier <code>opportunities.json</code>.
      </p>

      <form action="/admin/new" method="post" class="admin-form">
        <div class="admin-grid">

          <div class="form-group">
  <label>
    <input type="checkbox" name="featured" value="1" />
    Mettre cette opportunite en avant (section mise en avant sur la page d accueil)
  </label>
</div>

          <div class="form-group">
            <label for="title">Titre <span class="required">*</span></label>
            <input type="text" id="title" name="title" required />
          </div>

          <div class="form-group">
            <label for="organization">Organisation</label>
            <input type="text" id="organization" name="organization" />
          </div>

          <div class="form-group">
            <label for="country">Pays <span class="required">*</span></label>
            <input type="text" id="country" name="country" required />
          </div>

          <div class="form-group">
            <label for="city">Ville</label>
            <input type="text" id="city" name="city" />
          </div>

          <div class="form-group">
            <label for="type">Type d'opportunité <span class="required">*</span></label>
            <select id="type" name="type" required>
              <option value="">Choisir...</option>
              <option value="Stage">Stage</option>
              <option value="Bourse">Bourse</option>
              <option value="Volontariat">Volontariat</option>
              <option value="Job">Job</option>
            </select>
          </div>

          <div class="form-group">
            <label for="funding">Financement</label>
            <select id="funding" name="funding">
              <option value="">Non spécifié</option>
              <option value="Fully funded">Fully funded</option>
              <option value="Partially funded">Partially funded</option>
              <option value="Non financé">Non financé</option>
            </select>
          </div>

          <div class="form-group">
            <label for="deadline">Deadline</label>
            <input type="date" id="deadline" name="deadline" />
          </div>

          <div class="form-group">
            <label for="duration">Durée</label>
            <input type="text" id="duration" name="duration" placeholder="3 mois, 1 an..." />
          </div>

          <div class="form-group">
            <label for="link">Lien de candidature</label>
            <input type="url" id="link" name="link" placeholder="https://..." />
          </div>

          <div class="form-group">
            <label for="tags">Tags / Domaines</label>
            <input type="text" id="tags" name="tags" placeholder="ex : IT, Marketing, France..." />
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="4" placeholder="Décris l'opportunité..."></textarea>
        </div>

        <div class="form-group">
          <label for="extra">Profil / Conditions / Infos complémentaires</label>
          <textarea id="extra" name="extra" rows="4" placeholder="Profil recherché, conditions, avantages..."></textarea>
        </div>

        <div class="admin-actions">
          <a href="/admin" class="btn-secondary">Annuler</a>
          <button type="submit" class="btn-primary">Enregistrer l'opportunité</button>
        </div>

        <p class="admin-note">
          <span class="required">*</span> champs obligatoires.
        </p>
      </form>
    </div>
  </section>
</main>

<%- include('partials/footer', { page: 'admin' }) %>
