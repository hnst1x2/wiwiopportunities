# Exemple de configuration locale
PORT=3000

# Admin simple login
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secret de signature des sessions (admin + comptes membres) — OBLIGATOIRE en production.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (facultatif) URL publique pour les meta OG
PUBLIC_BASE_URL=https://wiwiopportunity.example.com

# (facultatif) Import IA dans l'admin — clé API Gemini (gratuite via https://aistudio.google.com)
# Sans clé, la carte "Import automatique" est simplement masquée.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Assistant virtuel (widget de chat public) — utilise la même GEMINI_API_KEY.
# Modèle Flash *Lite* par défaut : quota gratuit 500 req/jour (vs 20/jour pour les Flash).
# ASSISTANT_DAILY_LIMIT plafonne les appels/jour côté site pour protéger ce quota.
# GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# ASSISTANT_DAILY_LIMIT=300
