# Exemple de configuration locale
PORT=3000

# Admin simple login
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secret de signature des sessions (admin + comptes membres) — OBLIGATOIRE en production.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Jeton d'API pour les clients machine (agent opportunity-importer) : autorise
# POST /api/opportunities sans session admin, via "Authorization: Bearer <token>".
# Vide = aucun accès machine (seul l'admin connecté peut créer). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# (facultatif) Plafond d'emails de bienvenue newsletter envoyés par jour (défaut 200).
# NEWSLETTER_DAILY_EMAIL_LIMIT=200

# (facultatif mais recommandé) URL publique : meta OG, balise canonical, robots.txt et sitemap.xml
PUBLIC_BASE_URL=https://wiwiopportunity.example.com

# (facultatif) Google Analytics 4 — identifiant de mesure "G-XXXXXXXXXX".
# Vide = aucun script Google chargé (la CSP n'autorise gtag que si cette variable est définie).
# Chargé uniquement sur les pages publiques. ATTENTION : pour un public en Europe
# (RGPD / ePrivacy), activer GA impose un bandeau de consentement — non fourni ici.
# Les stats membres / opportunités les plus vues / connectés sont de toute façon
# calculées en interne (onglet Statistiques de l'admin), sans Google.
# GA_MEASUREMENT_ID=

# (facultatif) Secret dédié au hachage des IP des visiteurs anonymes dans les stats
# internes (défaut : SESSION_SECRET). Générer comme SESSION_SECRET.
# ANALYTICS_SALT=

# (facultatif) Fuseau horaire d'affichage des dates dans l'admin (défaut Africa/Tunis).
# DISPLAY_TIMEZONE=Africa/Tunis

# (facultatif) Import IA dans l'admin — clé API Gemini (gratuite via https://aistudio.google.com)
# Sans clé, la carte "Import automatique" est simplement masquée.
GEMINI_API_KEY=
# Modèle d'extraction. Défaut : gemini-3.6-flash. Aux heures chargées, l'API
# répond « experiencing high demand » (503) : les appels sont réessayés
# automatiquement (voir server/gemini.js). Mesuré le 2026-09-22 : gemini-3.5-flash
# n'est PAS plus disponible que la 3.6 pendant une congestion — les deux échouent
# de la même façon sur le gros prompt d'import. Ne pas rétrograder en espérant
# gagner en disponibilité.
# GEMINI_MODEL=gemini-3.6-flash

# Assistant virtuel (widget de chat public) — utilise la même GEMINI_API_KEY.
# Modèle Flash *Lite* par défaut : quota gratuit 500 req/jour (vs 20/jour pour les Flash).
# ASSISTANT_DAILY_LIMIT plafonne les appels/jour côté site pour protéger ce quota.
# GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# ASSISTANT_DAILY_LIMIT=300
