# Exemple de configuration locale
PORT=3000

# Admin simple login
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Secret de signature des sessions (admin + comptes membres) — OBLIGATOIRE en production.
# Générer par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Jeton d'API pour les clients machine (agent opportunity-importer) : autorise
# POST /api/opportunities sans session admin, via "Authorization: Bearer <token>".
# Vide = aucun accès machine (seul l'admin connecté peut créer). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# (facultatif) Plafond d'emails de bienvenue newsletter envoyés par jour (défaut 200).
# NEWSLETTER_DAILY_EMAIL_LIMIT=200

# (facultatif) URL publique pour les meta OG
PUBLIC_BASE_URL=https://wiwiopportunity.example.com

# (facultatif) Import IA dans l'admin — clé API Gemini (gratuite via https://aistudio.google.com)
# Sans clé, la carte "Import automatique" est simplement masquée.
GEMINI_API_KEY=
# Modèle d'extraction. Défaut : gemini-3.6-flash — récent et très sollicité, il
# répond parfois « experiencing high demand » (503). Les appels sont réessayés
# automatiquement ; en cas d'échecs répétés, basculer sur un modèle plus stable.
# GEMINI_MODEL=gemini-3.5-flash

# Assistant virtuel (widget de chat public) — utilise la même GEMINI_API_KEY.
# Modèle Flash *Lite* par défaut : quota gratuit 500 req/jour (vs 20/jour pour les Flash).
# ASSISTANT_DAILY_LIMIT plafonne les appels/jour côté site pour protéger ce quota.
# GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
# ASSISTANT_DAILY_LIMIT=300
